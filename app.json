{
  "expo": {
    "name": "FaujiDhara",
    "slug": "fauji-dhara",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAF7F0",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.faujidhara.app"
    },
    "android": {
      "package": "com.faujidhara.app",
      "adaptiveIcon": {
        "backgroundColor": "#556B2F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-asset",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#556B2F"
        }
      ]
    ],
    "scheme": "faujidhara",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "a7b02661-0c8e-43c8-a1e1-a5182a981341"
      }
    },
    "owner": "codeyuva-labs"
  }
}
