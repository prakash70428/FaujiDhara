# Copy this file to .env.local and fill in your Supabase project values.
# Supabase Dashboard → Project Settings → API Keys.
#
# Both values are PUBLIC by design (they ship inside the app). Your data is protected
# by Row Level Security in supabase/migrations, not by hiding these keys.
# Never put the secret / service_role key here.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
